{
  "name": "Post-Job Review Request with Sentiment Gate",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "job-complete",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "id": "806422b4-2f75-49c1-b737-bdd9e5d3e526",
      "name": "Job Complete Trigger"
    },
    {
      "parameters": {
        "tableId": "reviews",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "job_id",
              "fieldValue": "={{ $json.body.job_id }}"
            },
            {
              "fieldId": "customer_name",
              "fieldValue": "={{ $json.body.customer_name }}"
            },
            {
              "fieldId": "email",
              "fieldValue": "={{ $json.body.email }}"
            },
            {
              "fieldId": "technician_name",
              "fieldValue": "={{ $json.body.technician_name }}"
            },
            {
              "fieldId": "status",
              "fieldValue": "pending"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        224,
        0
      ],
      "id": "c2dbb811-ef1e-4595-bf3b-5e9c0806be66",
      "name": "Log New Review Request",
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_SUPABASE_CREDENTIAL_ID",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "How was your service today?",
        "message": "=<p>Hi {{ $json.customer_name }},</p> <p>Thank you for choosing us! How was your recent service with {{ $json.technician_name }}?</p> <p>   <a href=\"https://YOUR_N8N_DOMAIN/webhook/review-response?job_id={{ $json.job_id }}&sentiment=positive\" style=\"background:#4CAF50;color:white;padding:10px 20px;text-decoration:none;border-radius:5px;margin-right:10px;\">😊 Great!</a>   <a href=\"https://YOUR_N8N_DOMAIN/webhook/review-response?job_id={{ $json.job_id }}&sentiment=negative\" style=\"background:#f44336;color:white;padding:10px 20px;text-decoration:none;border-radius:5px;\">😞 Not Great</a> </p>",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        448,
        0
      ],
      "id": "5ddab554-df39-4a88-bb6f-6c1d2b1b17f9",
      "name": "Send Feedback Request Email",
      "retryOnFail": true,
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account 3"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=Feedback email failed to send for job {{ $json.job_id }}, customer {{ $json.customer_name }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        672,
        0
      ],
      "id": "82df740d-1cf6-4249-8c99-85add9af755f",
      "name": "Alert: Feedback Email Failed",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "path": "review-response",
