          "fieldValues": [
            {
              "fieldId": "sentiment",
              "fieldValue": "={{ $json.query.sentiment }}"
            },
            {
              "fieldId": "status",
              "fieldValue": "responded"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        224,
        384
      ],
      "id": "6f85f904-b560-4916-a387-90f9fdff7f8b",
      "name": "Update Sentiment",
      "retryOnFail": true,
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_SUPABASE_CREDENTIAL_ID",
