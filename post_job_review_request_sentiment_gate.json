      "credentials": {
        "telegramApi": {
          "id": "REPLACE_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "affa8bb1-f922-454c-b3bd-d47189cad01b",
              "leftValue": "={{ $json.query.sentiment }}",
              "rightValue": "positive",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        448,
        288
      ],
      "id": "31cd5913-0b16-4ce3-8539-f8091730e2cc",
      "name": "Sentiment Gate"
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "Thanks for your feedback!",
        "message": "=<p>Hi {{ $json.customer_name }},</p>  <p>Thank you so much for your positive feedback! We're glad you had a great experience with {{ $json.technician_name }}.</p>  <p>Would you mind sharing your experience publicly? It really helps our business grow.</p>  <p>   <a href=\"https://YOUR_GOOGLE_REVIEW_LINK\" style=\"background:#4285F4;color:white;padding:10px 20px;text-decoration:none;border-radius:5px;\">⭐ Leave a Google Review</a> </p>  <p>Thank you again!</p>",
        "options": {
          "appendAttribution": false
        }
      },
